{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ophalo.com/schemas/updates.schema.json",
  "title": "OpHalo Help & Updates feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries", "guides"],
  "properties": {
    "schema": { "const": 1 },
    "entries": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/entry" } },
    "guides": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/guide" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "markdown": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "published_at", "section", "title", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "published_at": { "type": "string", "format": "date-time" },
        "section": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$", "description": "V1 uses known_issue, whats_new, or coming_soon. Other valid values render under the neutral fallback heading." },
        "status": { "enum": ["active", "resolved"], "default": "active" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "$ref": "#/$defs/markdown" },
        "highlight": { "type": "boolean", "default": false },
        "banner_until": { "type": "string", "format": "date-time" }
      }
    },
    "guide": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "updated_at", "title", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "updated_at": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "$ref": "#/$defs/markdown" }
      }
    }
  }
}
