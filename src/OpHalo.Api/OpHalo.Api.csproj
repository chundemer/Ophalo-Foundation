<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d1424e0f-ac1a-47ec-8d98-4068b00e7081</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Explicitly override ASP.NET Core 10's vulnerable transitive 2.0.0 dependency.
         Stay on the compatible 2.x line; 2.7.5 is the first patched release for CVE-2026-49451. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.10.0" />
    <!-- Draft 2020-12 JSON-Schema validator for the Help &amp; Updates feed (GAP-038, BL149).
         The reviewed contract artifact is embedded below and validated as-is so it cannot
         drift from docs/contracts/updates.schema.json. -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical Help &amp; Updates feed schema (GAP-038). Linked from docs/ rather than copied
         so the repo keeps a single source of truth; LogicalName is pinned so the manifest
         lookup in UpdatesFeedCache is deterministic. -->
    <EmbeddedResource Include="..\..\docs\contracts\updates.schema.json" LogicalName="OpHalo.Api.Updates.updates.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpHalo.Foundation.Application\OpHalo.Foundation.Application.csproj" />
    <ProjectReference Include="..\OpHalo.Foundation.Infrastructure\OpHalo.Foundation.Infrastructure.csproj" />
    <ProjectReference Include="..\OpHalo.Keep.Application\OpHalo.Keep.Application.csproj" />
    <ProjectReference Include="..\OpHalo.Keep.Infrastructure\OpHalo.Keep.Infrastructure.csproj" />
  </ItemGroup>

</Project>
