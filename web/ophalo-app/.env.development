# Local development defaults (ADR-378, build-log/067)
# API host — must be running locally; see docs/runbook/local-web-setup.md
VITE_API_BASE_URL=http://localhost:5092
# Public auth/entry surface — ophalo-web (S13 deferred; use API magic link flow for now)
VITE_PUBLIC_BASE_URL=http://localhost:3000
# Sentry browser DSN (GAP-039) — public config, not a secret. Leave unset locally: initSentry()
# is a no-op without it. Required on the Vercel Production environment (see vite.config.ts).
# VITE_SENTRY_DSN=
